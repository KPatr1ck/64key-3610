#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3
#define MSE     4

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <170>;
};

&mt {
    tapping-term-ms = <130>;
    quick-tap-ms = <130>;
    flavor = "balanced";
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "L_CLK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp LCLK>, <&mkp LCLK>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "M_CLK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp MCLK>, <&mkp MCLK>;
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "R_CLK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp RCLK>, <&mkp RCLK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        LeftClick {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp LCLK>;
            slow-release;
        };

        RightClick {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mkp RCLK>;
            slow-release;
        };

        MiddleClick {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&mkp MCLK>;
            slow-release;
        };

        PareLeft {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp LEFT_PARENTHESIS>;
            slow-release;
        };

        PareRight {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            slow-release;
        };

        BrakLeft {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            slow-release;
        };

        BrakRight {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 34>;
            timeout-ms = <50>;
            slow-release;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
            timeout-ms = <50>;
            slow-release;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
            timeout-ms = <50>;
            slow-release;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            timeout-ms = <50>;
            slow-release;
        };

        Quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <21 22>;
            timeout-ms = <50>;
            slow-release;
        };

        Colon {
            bindings = <&kp COLON>;
            key-positions = <16 15>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_A {
            bindings = <&kp LC(A)>;
            key-positions = <27 13>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_Z {
            bindings = <&kp LC(Z)>;
            key-positions = <27 25>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_V {
            bindings = <&kp LC(V)>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_Q {
            bindings = <&kp LC(Q)>;
            key-positions = <1 27>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_X {
            bindings = <&kp LC(X)>;
            key-positions = <27 26>;
            timeout-ms = <50>;
            slow-release;
        };
    };

    macros {
        to_mac: to_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &to 0>;
            label = "TO_MAC";
        };

        to_win: to_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_USB &to 0>;
            label = "TO_WIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp TAB           &mt LCTRL Q  &kp W      &kp E      &kp R     &kp T           &kp Y  &kp U        &kp I      &kp O      &kp P     &kp BACKSPACE
&kp LEFT_CONTROL  &kp A        &kp S      &kp D      &kp F     &kp G           &kp H  &kp J        &kp K      &kp L      &kp SEMI  &kp SQT
&kp CAPSLOCK      &kp Z        &kp X      &kp C      &kp V     &kp B           &kp N  &kp M        &kp COMMA  &kp DOT    &kp FSLH  &mo 1
                               &kp LC(C)  &kp LC(V)  &mo 3     &kp LEFT_SHIFT  &none  &lt 4 SPACE  &kp LC(Z)  &kp LC(Y)
                               &none      &none      &kp LGUI  &none           &none  &none        &none      &kp LALT
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        AUTO-MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        NAVI {
            bindings = <
&trans  &trans  &trans    &kp UP_ARROW  &trans     &bt BT_PRV  &bt BT_NXT     &trans   &kp CAPSLOCK  &trans         &out OUT_TOG   &bt BT_SEL 0
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans      &kp GRAVE      &kp INS  &kp HOME      &kp PAGE_UP    &kp BACKSPACE  &none
&mo 6   &trans  &trans    &trans        &trans     &trans      &kp BACKSLASH  &kp DEL  &kp END       &kp PAGE_DOWN  &trans         &trans
                &trans    &trans        &trans     &trans      &trans         &mo 5    &trans        &trans
                &trans    &trans        &trans     &trans      &trans         &trans   &trans        &trans
            >;
        };

        NUM {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9     &kp N0     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DOT    &trans     &mo 6
                &trans  &trans  &mo 5   &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        FUNC {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp F6      &kp F7  &kp F8  &kp F9   &kp F10  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans      &trans  &trans  &kp F11  &kp F12  &trans
&trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &bt BT_CLR  &trans  &trans  &trans   &trans   &trans
                &trans  &trans  &trans  &trans          &trans      &trans  &trans  &trans
                &trans  &trans  &trans  &trans          &trans      &trans  &trans  &trans
            >;
        };

        BL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &sys_reset   &sys_reset   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans
                &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans
            >;
        };
    };
};
